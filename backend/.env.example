NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/jampals
MONGO_CONNECT_TIMEOUT_MS=5000
JWT_SECRET=replace-with-a-long-random-secret

# Add the deployed frontend origin here when it runs on a different domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional sign-in providers
GOOGLE_CLIENT_ID=
SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional hosted email delivery over HTTPS (works on free Render services)
RESEND_API_KEY=
EMAIL_FROM=
